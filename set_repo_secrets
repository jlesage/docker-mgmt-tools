#!/bin/sh

set -e # Exit immediately if a command exits with a non-zero status.
set -u # Treat unset variables as an error.

die() {
    [ -z "$*" ] || echo "ERROR: $*"
    exit 1
}

die_usage() {
    [ -z "$*" ] || echo "ERROR: $*"
    echo
    usage
}

usage() {
    echo "usage: $0 REPO [REPO...]

Set repository secrets to the specified repositories.
"
    exit 1
}

ask_secret() {
    printf "%s" "$1" >&2 
    #: > /dev/null

    stty -echo
    read input_secret
    stty echo
    printf "\n" >&2
    echo "$input_secret"
}


[ -n "${1-}" ] || usage

for secret in DOCKERHUB_USERNAME DOCKERHUB_PASSWORD PUSHOVER_USER_KEY PUSHOVER_API_TOKEN; do
    secret_val="$(ask_secret "$secret: ")"
    for repo in "$@"; do
        echo "Setting secret $secret for $repo..."
        echo "$secret_val" | gh secret set "$secret" --repo "$repo"
    done
done
